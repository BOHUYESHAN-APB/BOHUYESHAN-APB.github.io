---
import { readdirSync } from 'node:fs'
import { join } from 'node:path'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  title: '摄影',
  description: '用快门收集的光：摄影作品集。照片原样呈现，文件名即图注。'
}

// 构建时自动扫描 public/img/photos/full/：
//   文件名格式：【标签1,标签2】图注.jpg ——【】内是标签，后面是图注
//   新增照片 = 丢进目录，无需改代码；改图注/标签 = 直接改文件名
const FULL_DIR = join(process.cwd(), 'public', 'img', 'photos', 'full')
const photos = readdirSync(FULL_DIR)
  .filter((f) => /\.(jpe?g|png|webp|avif)$/i.test(f))
  .sort((a, b) => a.localeCompare(b, 'zh-Hans-CN'))
  .map((f) => {
    const m = f.match(/^(?:【(?<tags>[^】]*)】)?(?<stem>.+)\.(?:jpe?g|png|webp|avif)$/i)
    const tags = (m?.groups?.tags ?? '')
      .split(/[,，]/)
      .map((t) => t.trim())
      .filter(Boolean)
    return {
      full: `/img/photos/full/${f}`,
      thumb: `/img/photos/thumb/${f}`,
      stem: m?.groups?.stem ?? f.replace(/\.[^.]+$/, ''),
      tags
    }
  })
---

<PageLayout {meta}>
  <main class='mx-auto w-full max-w-[70rem] px-1 sm:px-2'>
    <section class='ph-hero'>
      <p class='ph-kicker'>PHOTOGRAPHY</p>
      <h1>摄影</h1>
      <p class='ph-sub'>
        照片原样呈现，不改不裁。<span class='ph-hint'>胶囊为内容标签。</span>
      </p>
    </section>

    <section class='ph-grid' id='ph-grid'>
      {
        photos.map((p, i) => (
          <figure class='ph-item' style={`--d:${(i % 3) * 110}ms`}>
            <button
              class='ph-thumb'
              type='button'
              aria-label={`查看大图（${p.tags.join(' / ') || '未分类'}）`}
              data-full={p.full}
              data-stem={p.stem}
              data-tags={p.tags.join(',')}
            >
              <img src={p.thumb} alt={p.stem} width='720' loading='lazy' decoding='async' />
              <span class='ph-veil' aria-hidden='true' />
              <span class='ph-zoom' aria-hidden='true'>
                ⤢
              </span>
            </button>
            <figcaption class='ph-cap'>
              {p.tags.length > 0 && (
                <span class='ph-tags'>
                  {p.tags.map((t) => (
                    <i class='ph-tag'>{t}</i>
                  ))}
                </span>
              )}
            </figcaption>
          </figure>
        ))
      }
    </section>
  </main>

  <div class='ph-lightbox' id='ph-lightbox' hidden>
    <button class='ph-lb-close' type='button' aria-label='关闭'>×</button>
    <button class='ph-lb-nav ph-lb-prev' type='button' aria-label='上一张'>‹</button>
    <figure class='ph-lb-stage'>
      <img id='ph-lb-img' src='' alt='' />
      <figcaption>
        <span id='ph-lb-tags'></span>
        <em id='ph-lb-counter'></em>
      </figcaption>
    </figure>
    <button class='ph-lb-nav ph-lb-next' type='button' aria-label='下一张'>›</button>
  </div>

  <style>
    .ph-hero {
      padding: 3.5rem 0 2rem;
    }
    .ph-kicker {
      font-size: 0.75rem;
      letter-spacing: 0.4em;
      color: hsl(var(--muted-foreground));
      animation: ph-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .ph-hero h1 {
      margin: 0.4rem 0 0.6rem;
      font-size: clamp(2.2rem, 5vw, 3.4rem);
      font-weight: 800;
      letter-spacing: 0.06em;
      animation: ph-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.08s both;
    }
    .ph-sub {
      color: hsl(var(--muted-foreground));
      animation: ph-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.16s both;
    }
    .ph-hint {
      margin-left: 0.5em;
      font-size: 0.85em;
      opacity: 0.75;
    }
    @keyframes ph-rise {
      from {
        opacity: 0;
        transform: translateY(18px);
        filter: blur(6px);
      }
      to {
        opacity: 1;
        transform: none;
        filter: none;
      }
    }

    .ph-grid {
      columns: 1;
      column-gap: 1.25rem;
    }
    @media (min-width: 640px) {
      .ph-grid {
        columns: 2;
      }
    }
    @media (min-width: 1024px) {
      .ph-grid {
        columns: 3;
      }
    }
    .ph-item {
      break-inside: avoid;
      margin: 0 0 1.4rem;
      opacity: 0;
      transform: translateY(30px);
      filter: blur(10px);
      transition:
        opacity 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms),
        transform 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms),
        filter 0.75s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms);
    }
    .ph-item.revealed {
      opacity: 1;
      transform: none;
      filter: none;
    }

    .ph-thumb {
      position: relative;
      display: block;
      width: 100%;
      padding: 0;
      border: 1px solid hsl(var(--border));
      border-radius: var(--radius, 0.75rem);
      overflow: hidden;
      cursor: zoom-in;
      background: hsl(var(--muted));
    }
    .ph-thumb img {
      display: block;
      width: 100%;
      height: auto;
      transform: scale(1.01);
      transition: transform 0.65s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .ph-veil {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgb(0 0 0 / 0.55), transparent 55%);
      opacity: 0;
      transition: opacity 0.45s ease;
    }
    .ph-zoom {
      position: absolute;
      right: 0.8rem;
      top: 0.8rem;
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      border-radius: 999px;
      color: #fff;
      background: rgb(0 0 0 / 0.45);
      backdrop-filter: blur(4px);
      font-size: 0.95rem;
      opacity: 0;
      transform: scale(0.6);
      transition:
        opacity 0.35s ease,
        transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .ph-thumb:hover img,
    .ph-thumb:focus-visible img {
      transform: scale(1.05);
    }
    .ph-thumb:hover .ph-veil,
    .ph-thumb:focus-visible .ph-veil {
      opacity: 1;
    }
    .ph-thumb:hover .ph-zoom,
    .ph-thumb:focus-visible .ph-zoom {
      opacity: 1;
      transform: none;
    }

    .ph-cap {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      padding: 0.55rem 0.2rem 0;
    }
    .ph-cap strong {
      font-size: 0.95rem;
      font-weight: 600;
    }
    .ph-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
    }
    .ph-tag {
      font-style: normal;
      font-size: 0.72rem;
      line-height: 1;
      padding: 0.25rem 0.5rem;
      border-radius: 999px;
      border: 1px solid hsl(var(--border));
      color: hsl(var(--muted-foreground));
    }

    .ph-lightbox {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgb(0 0 0 / 0.82);
      backdrop-filter: blur(10px);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .ph-lightbox.open {
      opacity: 1;
    }
    .ph-lightbox[hidden] {
      display: none;
    }
    .ph-lb-stage {
      margin: 0;
      max-width: min(92vw, 1100px);
      transform: scale(0.94);
      transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .ph-lightbox.open .ph-lb-stage {
      transform: none;
    }
    .ph-lb-stage img {
      display: block;
      max-width: 100%;
      max-height: 78vh;
      border-radius: var(--radius, 0.75rem);
      box-shadow: 0 24px 80px rgb(0 0 0 / 0.55);
    }
    .ph-lb-stage figcaption {
      display: flex;
      gap: 0.8rem;
      align-items: baseline;
      flex-wrap: wrap;
      padding-top: 0.7rem;
      color: #eee;
    }
    .ph-lb-stage figcaption em {
      margin-left: auto;
      font-style: normal;
      font-size: 0.8rem;
      color: #aaa;
    }
    .ph-lb-stage figcaption span {
      font-size: 0.82rem;
      color: #bbb;
    }
    .ph-lb-close,
    .ph-lb-nav {
      position: absolute;
      display: grid;
      place-items: center;
      border: 1px solid rgb(255 255 255 / 0.25);
      border-radius: 999px;
      background: rgb(255 255 255 / 0.08);
      color: #fff;
      cursor: pointer;
      transition:
        background 0.25s ease,
        transform 0.25s ease;
    }
    .ph-lb-close {
      top: 1.1rem;
      right: 1.1rem;
      width: 2.4rem;
      height: 2.4rem;
      font-size: 1.3rem;
    }
    .ph-lb-nav {
      top: 50%;
      width: 2.8rem;
      height: 2.8rem;
      font-size: 1.6rem;
      transform: translateY(-50%);
    }
    .ph-lb-prev {
      left: 1rem;
    }
    .ph-lb-next {
      right: 1rem;
    }
    .ph-lb-close:hover,
    .ph-lb-nav:hover {
      background: rgb(255 255 255 / 0.22);
    }
    .ph-lb-prev:active {
      transform: translateY(-50%) scale(0.92);
    }

    @media (prefers-reduced-motion: reduce) {
      .ph-kicker,
      .ph-hero h1,
      .ph-sub {
        animation: none;
      }
      .ph-item {
        opacity: 1;
        transform: none;
        filter: none;
        transition: none;
      }
      .ph-thumb img,
      .ph-lb-stage,
      .ph-lightbox {
        transition: none;
      }
    }
  </style>

  <script>
    const items = [...document.querySelectorAll<HTMLElement>('.ph-item')]
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // 滚动显现
    if (reduce) {
      items.forEach((el) => el.classList.add('revealed'))
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('revealed')
              io.unobserve(e.target)
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -5% 0px' }
      )
      items.forEach((el) => io.observe(el))
    }

    // 灯箱
    const shots = items.map((el) => {
      const btn = el.querySelector<HTMLButtonElement>('.ph-thumb')!
      return {
        full: btn.dataset.full!,
        stem: btn.dataset.stem!,
        tags: btn.dataset.tags ?? ''
      }
    })

    const lb = document.getElementById('ph-lightbox')!
    const lbImg = document.getElementById('ph-lb-img') as HTMLImageElement
    const lbTags = document.getElementById('ph-lb-tags')!
    const lbCounter = document.getElementById('ph-lb-counter')!

    let cur = 0
    let lastFocus: Element | null = null

    function render() {
      const s = shots[cur]
      lbImg.src = s.full
      lbImg.alt = s.stem
      lbTags.textContent = s.tags ? s.tags.split(',').map((t) => `#${t}`).join(' ') : ''
      lbCounter.textContent = `${cur + 1} / ${shots.length}`
    }
    function open(idx: number) {
      cur = idx
      render()
      lastFocus = document.activeElement
      lb.hidden = false
      requestAnimationFrame(() => lb.classList.add('open'))
      document.documentElement.style.overflow = 'hidden'
      lb.querySelector<HTMLButtonElement>('.ph-lb-close')?.focus()
    }
    function close() {
      lb.classList.remove('open')
      document.documentElement.style.overflow = ''
      setTimeout(() => {
        lb.hidden = true
      }, 300)
      if (lastFocus instanceof HTMLElement) lastFocus.focus()
    }
    function step(d: number) {
      cur = (cur + d + shots.length) % shots.length
      render()
    }

    items.forEach((el, i) => {
      el.querySelector('.ph-thumb')?.addEventListener('click', () => open(i))
    })
    lb.querySelector('.ph-lb-close')?.addEventListener('click', close)
    lb.querySelector('.ph-lb-prev')?.addEventListener('click', () => step(-1))
    lb.querySelector('.ph-lb-next')?.addEventListener('click', () => step(1))
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close()
    })
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return
      if (e.key === 'Escape') close()
      else if (e.key === 'ArrowLeft') step(-1)
      else if (e.key === 'ArrowRight') step(1)
    })
  </script>
</PageLayout>
