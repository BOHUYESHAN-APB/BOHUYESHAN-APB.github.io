---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: '页面不存在',
  title: '404'
}
---

<PageLayout {meta}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground'>页面走丢了。</p>
    <p class='text-lg'>
      你要找的页面不存在或已移动。旧文章请移步
      <a class='underline decoration-dashed underline-offset-4' href='/old/'>/old/ 存档站</a>。
    </p>
    <Button title='回到首页' href='/' variant='ahead' class='mt-5' />
  </div>
</PageLayout>
