---
/**
 * Client-side Mermaid renderer.
 *
 * A remark plugin (astro.config.ts) converts ```mermaid fences into
 * `<div class="mermaid-block" data-source="...">` placeholders before shiki
 * sees them; this component renders each one from its data-source.
 * mermaid.js is vendored locally at /js/mermaid.min.js (no CDN).
 */
---
<script is:inline>
  (function () {
    var blocks = document.querySelectorAll(".mermaid-block[data-source]");
    if (!blocks.length) return;

    function load(cb) {
      if (window.mermaid) return cb(window.mermaid);
      var s = document.createElement("script");
      s.src = "/js/mermaid.min.js";
      s.onload = function () {
        if (!window.mermaid) return cb(null);
        window.mermaid.initialize({
          startOnLoad: false,
          theme:
            document.documentElement.dataset.theme === "dark"
              ? "dark"
              : "default",
          fontFamily: "system-ui, sans-serif",
        });
        cb(window.mermaid);
      };
      s.onerror = function () {
        cb(null);
      };
      document.head.appendChild(s);
    }

    load(function (mermaid) {
      if (!mermaid) return;
      blocks.forEach(function (div, i) {
        var source = decodeURIComponent(div.dataset.source || "");
        mermaid
          .render("mmd-" + i + "-" + Date.now(), source)
          .then(function (r) {
            div.innerHTML = r.svg;
            div.style.margin = "1.5rem 0";
            div.style.textAlign = "center";
            div.style.overflowX = "auto";
          })
          .catch(function () {
            var pre = document.createElement("pre");
            var code = document.createElement("code");
            code.textContent = source;
            pre.appendChild(code);
            div.replaceWith(pre);
          });
      });
    });
  })();
</script>
