---
/**
 * Hydrates `.pdb3d` divs carried over from the old Butterfly theme.
 *
 * Butterfly rendered these via hexo-butterfly-extjs (3Dmol.js). Migrated posts
 * keep the original markup and `data-cfg` JSON verbatim, so this component
 * re-implements the same contract: { pdb, bg, styles: [{sel, style}], zoom: {sel} }.
 * 3Dmol.js loads lazily from CDN; on failure the divs stay inert and the reader
 * is pointed at the /old/ archive.
 */
---
<script is:inline>
  (function () {
    var CDNS = [
      "https://cdn.jsdelivr.net/npm/3dmol@2.5.4/build/3Dmol-min.js",
      "https://unpkg.com/3dmol@2.5.4/build/3Dmol-min.js",
    ];

    function loadLibrary(i, cb) {
      if (window.$3Dmol) return cb(window.$3Dmol);
      if (i >= CDNS.length) return cb(null);
      var s = document.createElement("script");
      s.src = CDNS[i];
      s.onload = function () {
        cb(window.$3Dmol);
      };
      s.onerror = function () {
        loadLibrary(i + 1, cb);
      };
      document.head.appendChild(s);
    }

    function render(div, $3Dmol) {
      var cfg;
      try {
        cfg = JSON.parse(div.dataset.cfg || "{}");
      } catch (e) {
        return;
      }
      var bg = cfg.bg || "white";
      div.style.backgroundColor = bg;
      var viewer = $3Dmol.createViewer(div, { backgroundColor: bg });
      fetch(cfg.pdb)
        .then(function (r) {
          if (!r.ok) throw new Error("HTTP " + r.status);
          return r.text();
        })
        .then(function (data) {
          viewer.addModel(data, "pdb");
          (cfg.styles && cfg.styles.length
            ? cfg.styles
            : [{ sel: {}, style: { cartoon: { color: "spectrum" } } }]
          ).forEach(function (s) {
            viewer.addStyle(s.sel || {}, s.style);
          });
          if (cfg.zoom && cfg.zoom.sel) viewer.zoomTo(cfg.zoom.sel);
          else viewer.zoomToFit();
          viewer.setBackgroundColor(bg);
          viewer.render();
        })
        .catch(function () {
          div.innerHTML =
            '<p style="padding:16px;color:#888">3D 结构加载失败，请到 ' +
            '<a href="/old/">/old/ 存档站</a> 查看本节内容。</p>';
        });
    }

    function initAll() {
      var divs = document.querySelectorAll(".pdb3d:not([data-ready])");
      if (!divs.length) return;
      loadLibrary(0, function ($3Dmol) {
        if (!$3Dmol) return;
        divs.forEach(function (div) {
          div.dataset.ready = "1";
          render(div, $3Dmol);
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAll);
    } else {
      initAll();
    }
  })();
</script>
